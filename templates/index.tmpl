{{ define "index" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $aboutTitle := or (index .Page.Params "about_title") "about me" }}
    {{ $bannerImage := index .Page.Params "banner_image" }}
    {{ $bannerAlt := or (index .Page.Params "banner_alt") $aboutTitle }}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="{{ .Site.Description }}">
    <meta name="keywords" content="Oliver McInnes, Oli McInnes, Oli, Oliver, McInnes, programming, physics, personal blog, cv">
    <meta name="author" content="Oliver McInnes">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ .Site.URL }}/">

    <link rel="alternate" type="application/rss+xml" title="oli's site rss" href="{{ .Site.URL }}/rss.xml">

    <meta property="og:title" content="{{ .Site.Title }}">
    <meta property="og:description" content="{{ .Site.Description }}">
    <meta property="og:image" content="{{ .Site.URL }}/favicon.png">
    <meta property="og:url" content="{{ .Site.URL }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ .Site.Title }}">
    <meta name="twitter:description" content="{{ .Site.Description }}">
    <meta name="twitter:image" content="{{ .Site.URL }}/favicon.png">

    <title>{{ .Site.Title }}</title>
    <link rel="stylesheet" href="/styles.css" />
    {{ template "seven_seg_icon_assets" . }}
    <link rel="icon" href="/favicon.png" type="image/png" />
</head>
<body>
{{ $sideLinks := index .Site.Params "side_links" }}
{{ $posts := query "SELECT * FROM pages WHERE Featured=true AND Draft=false AND Section='posts' ORDER BY Updated DESC" | asPages }}
<main class="w-shell home-layout">
    <aside class="w-column w-rail">
        <h1 class="identity-title">
            <span class="identity-line">oli.</span>
            <span class="identity-line">mcinnes</span>
            <span class="identity-line identity-line-right">.cc</span>
        </h1>

        <nav class="w-linklist sidebar-links" aria-label="site">
            {{ range $link := $sideLinks }}
                {{ $iconMorph := or (index $link "icon_morph") (index $link "iconMorph") }}
                <a class="sidebar-link" href="{{ index $link "url" }}">
                    {{ if $iconMorph }}{{ template "seven_seg_icon" $iconMorph }}{{ end }}
                    <span class="sidebar-link-label">{{ index $link "label" }}</span>
                </a>
            {{ end }}
        </nav>
    </aside>

    <section class="home-main">
        <article class="w-panel">
            <div class="about-banner-frame"><img class="about-banner-image" src="{{ $bannerImage }}" alt="{{ $bannerAlt }}" /></div>
            <h2 class="w-subtitle">{{ $aboutTitle }}</h2>
            <div class="about-body">{{ .Page.Body }}</div>
        </article>

        <section class="post-list-wrap">
            <div class="section-head">
                <div class="w-label">featured:</div>
                <a class="section-link" href="/posts/">[all posts]</a>
            </div>

            <section class="post-list">
            {{ range $post := $posts }}
                {{ $postIconMorph := or (index $post.Params "index_icon_morph") (index $post.Params "_index_icon_morph") }}
                <article class="w-panel post-card">
                    <a class="post-card-mark post-card-primary-link" href="{{ $post.Canon }}" aria-label="{{ $post.Title }}">
                        {{ if $postIconMorph }}{{ template "seven_seg_icon" $postIconMorph }}{{ end }}
                    </a>
                    <div class="post-card-content">
                        <div class="post-card-meta-row">
                            <div class="post-card-meta">{{ datefmt "2006-01-02" $post.PubDate }}</div>
                            {{ if $post.Tags }}
                                <div class="post-card-tags">
                                    {{ range $tag := $post.Tags }}
                                        <a class="post-card-state post-card-tag post-card-tag-link" href="/tags/{{ $tag }}/">{{ $tag }}</a>
                                    {{ end }}
                                </div>
                            {{ end }}
                        </div>
                        <h2 class="post-card-title"><a class="post-card-primary-link" href="{{ $post.Canon }}">{{ $post.Title }}</a></h2>
                        {{ if $post.Description }}
                            <p class="post-card-desc">{{ $post.Description }}</p>
                        {{ end }}
                    </div>
                </article>
            {{ end }}
            </section>
        </section>
    </section>
</main>
</body>
</html>
{{ end }}
