{{ define "index" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $aboutTitle := or (index .Page.Params "about_title") "about me" }}
    {{ $bannerImage := index .Page.Params "banner_image" }}
    {{ $bannerAlt := or (index .Page.Params "banner_alt") $aboutTitle }}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="{{ .Site.Description }}">
    <meta name="keywords" content="Oliver McInnes, Oli McInnes, Oli, Oliver, McInnes, programming, physics, personal blog, cv">
    <meta name="author" content="Oliver McInnes">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ .Site.URL }}/">

    <link rel="alternate" type="application/rss+xml" title="Oli's site RSS" href="{{ .Site.URL }}/rss.xml">

    <meta property="og:title" content="{{ .Site.Title }}">
    <meta property="og:description" content="{{ .Site.Description }}">
    <meta property="og:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">
    <meta property="og:url" content="{{ .Site.URL }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ .Site.Title }}">
    <meta name="twitter:description" content="{{ .Site.Description }}">
    <meta name="twitter:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">

    <title>{{ .Site.Title }}</title>
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/home.css" />
    <link rel="stylesheet" href="/assets/css/posts.css" />
    <link rel="stylesheet" href="/assets/css/albums.css" />
    {{ template "icon_assets" . }}
    {{ template "favicon_assets" . }}
</head>
<body>
{{ $posts := query "SELECT * FROM pages WHERE Featured=true AND Draft=false AND Section='posts' ORDER BY Weight ASC" | asPages }}
{{ $albums := query "SELECT * FROM pages WHERE Featured=true AND Draft=false AND Section='photos' ORDER BY Weight ASC, Updated DESC" | asPages }}
<main class="w-shell home-layout">
    {{ template "site_nav_home" . }}

    <section class="home-main">
        <article class="w-panel">
            <div class="about-banner-frame">
                <img class="about-banner-image" src="{{ $bannerImage }}" alt="{{ $bannerAlt }}" />
                <h1 class="about-banner-title">olimci</h1>
            </div>
            <div class="about-body">{{ .Page.Body }}</div>
        </article>

        <section class="post-list-wrap">
            <div class="section-head">
                <div class="w-label">featured:</div>
                <a class="section-link" href="/posts/">[all posts]</a>
            </div>

            <section class="post-list">
            {{ range $post := $posts }}
                <article class="w-panel post-card">
                    <div class="post-card-content">
                        <div class="post-card-meta-row">
                            <div class="post-card-meta">{{ datefmt "2006-01-02" $post.PubDate }}</div>
                            {{ if $post.Tags }}
                                <div class="post-card-tags">
                                    {{ range $tag := $post.Tags }}
                                        <a class="post-card-state post-card-tag post-card-tag-link" href="/tags/{{ $tag }}/">{{ $tag }}</a>
                                    {{ end }}
                                </div>
                            {{ end }}
                        </div>
                        <h2 class="post-card-title"><a class="post-card-primary-link" href="{{ $post.Canon }}">{{ $post.Title }}</a></h2>
                        {{ if $post.Description }}
                            <p class="post-card-desc">{{ $post.Description }}</p>
                        {{ end }}
                    </div>
                </article>
            {{ end }}
            </section>
        </section>

        {{ with index .Page.Params "photos_intro" }}
            <article class="w-panel home-copy-panel">
                <p>{{ . }}</p>
            </article>
        {{ end }}

        <section class="album-list-wrap">
            <div class="section-head">
                <div class="w-label">photos:</div>
                <a class="section-link" href="/photos/">[all photos]</a>
            </div>

            <section class="album-list album-list-home">
            {{ range $album := $albums }}
                {{ $cover := index $album.Params "cover" }}
                {{ $count := index $album.Params "photo_count" }}
                <article class="w-panel album-card">
                    <a class="album-card-image-link" href="{{ $album.Canon }}" aria-label="{{ $album.Title }}">
                        <img class="album-card-image" src="{{ $cover }}" alt="" loading="lazy" />
                    </a>
                    <div class="album-card-body">
                        <div class="post-card-meta-row">
                            {{ if $count }}<span class="post-card-meta">{{ $count }} photos</span>{{ end }}
                            {{ range $tag := $album.Tags }}<span class="post-card-state post-card-tag">{{ $tag }}</span>{{ end }}
                        </div>
                        <h2 class="post-card-title"><a class="post-card-primary-link" href="{{ $album.Canon }}">{{ $album.Title }}</a></h2>
                        {{ if $album.Description }}<p class="post-card-desc">{{ $album.Description }}</p>{{ end }}
                    </div>
                </article>
            {{ end }}
            </section>
        </section>

        {{ with index .Page.Params "photos_outro" }}
            <article class="w-panel home-copy-panel">
                <p>{{ . }}</p>
            </article>
        {{ end }}
    </section>
    {{ template "site_footer" . }}
</main>
</body>
</html>
{{ end }}
