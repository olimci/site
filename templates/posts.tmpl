{{ define "posts" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or .Page.Description .Site.Description }}
    {{ $pageURL := or .Page.Canon (printf "%s/%s/" .Site.URL .Page.Slug) }}
    {{ $pageTitle := printf "%s | %s" .Page.Title .Site.Title }}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="{{ $pageDescription }}">
    <meta name="author" content="Oliver McInnes">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ $pageURL }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">
    <meta property="og:url" content="{{ $pageURL }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ $pageTitle }}">
    <meta name="twitter:description" content="{{ $pageDescription }}">
    <meta name="twitter:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">

    <title>{{ $pageTitle }}</title>
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/posts.css" />
    <link rel="stylesheet" href="/assets/css/article.css" />
    {{ template "icon_assets" . }}
    {{ template "favicon_assets" . }}
</head>
<body>
{{ $posts := query "SELECT * FROM pages WHERE Section='posts' ORDER BY PubDate DESC" | asPages }}
<main class="w-shell page-layout">
    {{ template "site_nav_archive" . }}

    <section class="page-main">
        <header class="w-panel article-panel page-header archive-header">
            <h1 class="w-title medium">{{ .Page.Title }}</h1>
            {{ if .Page.Description }}<p class="archive-note">{{ .Page.Description }}</p>{{ end }}
        </header>

        <div class="section-head archive-section-head">
            <div class="w-label">posts:</div>
            <nav class="archive-section-links" aria-label="Post archive links">
                <a class="section-link" href="/tags/">[all tags]</a>
            </nav>
        </div>

        <section class="post-list post-list-states">
            {{ range $post := $posts }}
                {{ if or $.Site.Meta.IsDev (not $post.Draft) }}
                    <article class="w-panel post-card{{ if $post.Featured }} is-featured{{ end }}{{ if $post.Draft }} is-draft{{ end }}">
                        <div class="post-card-content">
                            <div class="post-card-meta-row">
                                <div class="post-card-meta">{{ datefmt "2006-01-02" $post.PubDate }}</div>
                                {{ if $post.Featured }}
                                    <div class="post-card-flags">
                                        <span class="post-card-state featured">featured</span>
                                        {{ if $post.Draft }}<span class="post-card-state draft">draft</span>{{ end }}
                                    </div>
                                {{ else if $post.Draft }}
                                    <div class="post-card-flags">
                                        <span class="post-card-state draft">draft</span>
                                    </div>
                                {{ end }}
                                {{ if $post.Tags }}
                                    <div class="post-card-tags">
                                        {{ range $tag := $post.Tags }}
                                            <a class="post-card-state post-card-tag post-card-tag-link" href="/tags/{{ $tag }}/">{{ $tag }}</a>
                                        {{ end }}
                                    </div>
                                {{ end }}
                            </div>
                            <h2 class="post-card-title"><a class="post-card-primary-link" href="{{ $post.Canon }}">{{ $post.Title }}</a></h2>
                            {{ if $post.Description }}
                                <p class="post-card-desc">{{ $post.Description }}</p>
                            {{ end }}
                        </div>
                    </article>
                {{ end }}
            {{ end }}
        </section>
    </section>
    {{ template "site_footer" . }}
</main>
</body>
</html>
{{ end }}
