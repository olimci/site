{{ define "photos" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or .Page.Description .Site.Description }}
    {{ $pageURL := or .Page.Canon (printf "%s/%s/" .Site.URL .Page.Slug) }}
    {{ $pageTitle := printf "%s | %s" .Page.Title .Site.Title }}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="{{ $pageDescription }}">
    <meta name="author" content="Oliver McInnes">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ $pageURL }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ .Site.URL }}/favicon.png">
    <meta property="og:url" content="{{ $pageURL }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ $pageTitle }}">
    <meta name="twitter:description" content="{{ $pageDescription }}">
    <meta name="twitter:image" content="{{ .Site.URL }}/favicon.png">

    <title>{{ $pageTitle }}</title>
    <link rel="stylesheet" href="/styles.css" />
    {{ template "seven_seg_icon_assets" . }}
    <link rel="icon" href="/favicon.png" type="image/png" />
</head>
<body>
{{ $albums := index .Page.Queries "albums" | asPages }}
<main class="w-shell page-layout">
    {{ template "site_nav_archive" . }}

    <section class="page-main">
        <header class="page-header">
            <h1 class="w-title medium">{{ .Page.Title }}</h1>
            {{ if .Page.Description }}<p class="archive-note">{{ .Page.Description }}</p>{{ end }}
        </header>

        <section class="album-list album-list-page">
            {{ range $album := $albums }}
                {{ if or $.Site.Meta.IsDev (not $album.Draft) }}
                    {{ template "album_card" $album }}
                {{ end }}
            {{ end }}
        </section>
    </section>
</main>
</body>
</html>
{{ end }}

{{ define "album_card" }}
{{ $cover := index .Params "cover" }}
{{ $count := index .Params "photo_count" }}
<article class="w-panel album-card">
    <a class="album-card-image-link" href="{{ .Canon }}" aria-label="{{ .Title }}">
        <img class="album-card-image" src="{{ $cover }}" alt="" loading="lazy" />
    </a>
    <div class="album-card-body">
        <div class="post-card-meta-row">
            {{ if $count }}<span class="post-card-meta">{{ $count }} photos</span>{{ end }}
            {{ if .Featured }}<span class="post-card-state featured">featured</span>{{ end }}
            {{ if .Draft }}<span class="post-card-state draft">draft</span>{{ end }}
            {{ range $tag := .Tags }}<span class="post-card-state post-card-tag">{{ $tag }}</span>{{ end }}
        </div>
        <h2 class="post-card-title"><a class="post-card-primary-link" href="{{ .Canon }}">{{ .Title }}</a></h2>
        {{ if .Description }}<p class="post-card-desc">{{ .Description }}</p>{{ end }}
    </div>
</article>
{{ end }}
