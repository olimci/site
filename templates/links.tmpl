{{ define "links" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or .Page.Description .Site.Description }}
    {{ $pageURL := or .Page.Canon (printf "%s/%s/" .Site.URL .Page.Slug) }}
    {{ $pageTitle := printf "%s | %s" .Page.Title .Site.Title }}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="{{ $pageDescription }}">
    <meta name="author" content="Oliver McInnes">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ $pageURL }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ .Site.URL }}/favicon.png">
    <meta property="og:url" content="{{ $pageURL }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ $pageTitle }}">
    <meta name="twitter:description" content="{{ $pageDescription }}">
    <meta name="twitter:image" content="{{ .Site.URL }}/favicon.png">

    <title>{{ $pageTitle }}</title>
    <link rel="stylesheet" href="/styles.css" />
    {{ template "icon_assets" . }}
    {{ template "favicon_assets" . }}
</head>
<body>
{{ $exportedLinks := or (index .Page.Params "exported_links") (index .Page.Params "links") }}
{{ $unexportedLinks := index .Page.Params "unexported_links" }}
<main class="w-shell page-layout linktree-layout">
    <section class="page-main">
        <header class="page-header linktree-header">
            <h1 class="w-title medium">{{ .Page.Title }}</h1>
            {{ if .Page.Description }}<p class="archive-note">{{ .Page.Description }}</p>{{ end }}
        </header>

        <section class="linktree-list" aria-label="links">
            <a class="w-panel linktree-card" href="/">
                <span class="linktree-icon">{{ template "nav_home_icon" . }}</span>
                <span class="linktree-label">Home</span>
            </a>
            {{ range $link := $exportedLinks }}
                {{ $iconMorph := or (index $link "icon_morph") (index $link "iconMorph") }}
                <a class="w-panel linktree-card" href="{{ index $link "url" }}">
                    <span class="linktree-icon">
                        {{ if $iconMorph }}{{ template "icon" $iconMorph }}{{ end }}
                    </span>
                    <span class="linktree-label">{{ index $link "label" }}</span>
                </a>
            {{ end }}
            {{ range $link := $unexportedLinks }}
                {{ $iconMorph := or (index $link "icon_morph") (index $link "iconMorph") }}
                <a class="w-panel linktree-card" href="{{ index $link "url" }}">
                    <span class="linktree-icon">
                        {{ if $iconMorph }}{{ template "icon" $iconMorph }}{{ end }}
                    </span>
                    <span class="linktree-label">{{ index $link "label" }}</span>
                </a>
            {{ end }}
        </section>
    </section>
</main>
</body>
</html>
{{ end }}
