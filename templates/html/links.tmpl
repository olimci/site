{{ define "links" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or .Page.Description .Site.Description }}
    {{ $pageTitle := printf "%s | %s" .Page.Title .Site.Title }}
    <meta name="description" content="{{ $pageDescription }}">
    <link rel="canonical" href="{{ .Page.Canon }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">
    <meta property="og:url" content="{{ .Page.Canon }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <title>{{ $pageTitle }}</title>
    {{ template "head_common" . }}
</head>
<body>
{{ template "topnav" "links" }}

{{ $exported := or (index .Page.Params "exported_links") (index .Page.Params "links") }}
{{ $unexported := index .Page.Params "unexported_links" }}

<main>
    <section class="page-header">
        <div class="page-header-inner">
            <h1>{{ .Page.Title }}.</h1>
            {{ if .Page.Description }}<p class="deck">{{ .Page.Description }}</p>{{ end }}
        </div>
    </section>

    <div class="shell">
        <div class="linktree">
            <a class="link-card" href="/">
                <span class="icon"><span class="symbol symbol-olimci" aria-hidden="true"></span></span>
                <span class="label">Home</span>
                <span class="host">olimci.com</span>
            </a>
            {{ range $link := $exported }}
                <a class="link-card" href="{{ index $link "url" }}">
                    <span class="icon"><span class="symbol symbol-olimci" aria-hidden="true"></span></span>
                    <span class="label">{{ index $link "label" }}</span>
                    <span class="host">{{ or (index $link "host") (index $link "url") }}</span>
                </a>
            {{ end }}
        </div>

        {{ if $unexported }}
        <div class="section-rule">elsewhere</div>
        <div class="linktree">
            {{ range $link := $unexported }}
                <a class="link-card" href="{{ index $link "url" }}">
                    <span class="icon"><span class="symbol symbol-olimci" aria-hidden="true"></span></span>
                    <span class="label">{{ index $link "label" }}</span>
                    <span class="host">{{ or (index $link "host") (index $link "url") }}</span>
                </a>
            {{ end }}
        </div>
        {{ end }}
    </div>
</main>

{{ template "site_footer" . }}
</body>
</html>
{{ end }}
