{{ define "photos" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or .Page.Description .Site.Description }}
    {{ $pageTitle := printf "%s | %s" .Page.Title .Site.Title }}
    <meta name="description" content="{{ $pageDescription }}">
    <link rel="canonical" href="{{ .Page.Canon }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">
    <meta property="og:url" content="{{ .Page.Canon }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <title>{{ $pageTitle }}</title>
    {{ template "head_common" . }}
</head>
<body>
{{ template "topnav" (dict "Data" . "Active" "photos") }}

{{ $albums := queryPages "SELECT * FROM pages WHERE Section='photos' AND (? OR Draft=false) ORDER BY Weight ASC, Updated DESC" .Site.Dev }}

<main>
    <section class="page-header">
        <div class="page-header-inner">
            <h1>{{ .Page.Title }}</h1>
            {{ if .Page.Description }}<p class="deck">{{ .Page.Description }}</p>{{ end }}
        </div>
    </section>

    <div class="shell">
        <div class="photo-albums">
            <div class="forum-subhead"><span>Album</span><span>Published</span></div>
            {{ range $album := $albums }}
                {{ $cover := index $album.Params "cover" }}
                <a class="photo-album" href="{{ $album.Path }}">
                    <img src="{{ $cover }}" alt="" loading="lazy">
                    <span class="photo-album-copy"><strong>{{ $album.Title }}</strong>{{ with $album.Description }}<small>{{ . }}</small>{{ end }}<small>{{ len (index $album.Params "photos") }} photos</small></span>
                    <time datetime="{{ datefmt "2006-01-02" $album.PubDate }}">{{ datefmt "02 Jan 2006" $album.PubDate }}</time>
                </a>
            {{ end }}
        </div>
    </div>
</main>

{{ template "site_footer" . }}
</body>
</html>
{{ end }}
