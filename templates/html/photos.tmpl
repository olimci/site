{{ define "photos" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or .Page.Description .Site.Description }}
    {{ $pageTitle := printf "%s | %s" .Page.Title .Site.Title }}
    <meta name="description" content="{{ $pageDescription }}">
    <link rel="canonical" href="{{ .Page.Canon }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">
    <meta property="og:url" content="{{ .Page.Canon }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <title>{{ $pageTitle }}</title>
    {{ template "head_common" . }}
</head>
<body>
{{ template "topnav" "photos" }}

{{ $albums := queryPages "SELECT * FROM pages WHERE Section='photos' AND (? OR Draft=false) ORDER BY Weight ASC, Updated DESC" .Site.Dev }}

<main>
    <section class="page-header">
        <div class="page-header-inner">
            <h1>{{ .Page.Title }}.</h1>
            {{ if .Page.Description }}<p class="deck">{{ .Page.Description }}</p>{{ end }}
        </div>
    </section>

    <div class="shell">
        <div class="cards cards-shelf">
            {{ range $album := $albums }}
                {{ $cover := index $album.Params "cover" }}
                <a class="card" href="{{ $album.Path }}">
                    <div class="card-cover" {{ if $cover }}style="background:#000 center/cover no-repeat url('{{ $cover }}')"{{ end }}></div>
                    <div class="card-body">
                        <h3>{{ $album.Title }}</h3>
                        <span class="meta">{{ datefmt "2006-01-02" $album.PubDate }}</span>
                        {{ with $album.Description }}<p>{{ . }}</p>{{ end }}
                    </div>
                </a>
            {{ end }}
        </div>
    </div>
</main>

{{ template "site_footer" . }}
</body>
</html>
{{ end }}
