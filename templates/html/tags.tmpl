{{ define "tags" }}
{{ query "select Tag, TagSlug, _page as Page from tags where Section = 'posts' and (? OR Draft=false) order by TagSlug asc, PubDate desc" .Site.Dev | paginateOnRoot "TagSlug" "tag-page" "tag-root" }}
{{ end }}

{{ define "tag-root" }}
{{ template "tags_document" (dict "Data" . "Mode" "root") }}
{{ end }}

{{ define "tag-page" }}
{{ template "tags_document" (dict "Data" . "Mode" "tag") }}
{{ end }}

{{ define "tags_document" }}
{{ $data := index . "Data" }}
{{ $mode := index . "Mode" }}
{{ $tagName := "" }}
{{ if and (eq $mode "tag") $data.Pagination }}
    {{ with first $data.Pagination.Items }}{{ $tagName = index . "Tag" }}{{ end }}
{{ end }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or $data.Page.Description $data.Site.Description }}
    {{ $pageTitle := printf "%s | %s" $data.Page.Title $data.Site.Title }}
    {{ if eq $mode "tag" }}
        {{ $pageTitle = printf "%v | Posts | %s" $tagName $data.Site.Title }}
        {{ $pageDescription = printf "Posts tagged %v" $tagName }}
    {{ end }}
    <meta name="description" content="{{ $pageDescription }}">
    <link rel="canonical" href="{{ $data.Page.Canon }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ $data.Site.URL }}/assets/favicon/favicon-white-on-black-512.png">
    <meta property="og:url" content="{{ $data.Page.Canon }}">
    <meta property="og:type" content="website">

    <title>{{ $pageTitle }}</title>
    {{ template "head_common" $data }}
    <link rel="stylesheet" href="/assets/css/posts.css">
</head>
<body>
{{ template "topnav" "posts" }}

{{ $posts := queryPages "SELECT * FROM pages WHERE Section='posts' AND (? OR Draft=false) ORDER BY PubDate DESC" $data.Site.Dev }}
{{ $summary := query "select Tag, TagSlug, count(PageTitle) as PostCount from tags where Section = 'posts' and (? OR Draft=false) group by TagSlug, Tag order by PostCount desc, Tag asc" $data.Site.Dev }}

<main class="posts-page">
    <section class="page-header">
        <div class="page-header-inner">
            {{ if eq $mode "tag" }}
                <h1>Posts.</h1>
            {{ else }}
                <span class="crumb"><a href="/posts/">posts</a> &nbsp;/&nbsp; tags</span>
                <h1>{{ $data.Page.Title }}.</h1>
                {{ if $data.Page.Description }}<p class="deck">{{ $data.Page.Description }}</p>{{ end }}
            {{ end }}
        </div>
    </section>

    <div class="shell">
        {{ if eq $mode "tag" }}
            {{ $activeSlug := "" }}
            {{ with first $data.Pagination.Items }}{{ $activeSlug = index . "TagSlug" }}{{ end }}
            <div class="chips">
                <a class="chip" href="/posts/">all <span class="n">{{ len $posts }}</span></a>
                {{ range $t := $summary }}
                    {{ $slug := index $t "TagSlug" }}
                    <a class="chip{{ if eq $slug $activeSlug }} is-active{{ end }}" href="/posts/tag/{{ $slug }}/">{{ index $t "Tag" }} <span class="n">{{ index $t "PostCount" }}</span></a>
                {{ end }}
                <a class="chip chip-more" href="/posts/tag/">*</a>
            </div>

            <div class="posts dither-surface">
            <canvas class="dither-field" aria-hidden="true"></canvas>
            <div class="posts-heading" aria-hidden="true">
                <span></span>
                <span>post</span>
                <span>date</span>
            </div>
            {{ range $row := $data.Pagination.Items }}
                {{ $post := index $row "Page" }}
                <a class="post dither-target" href="{{ $post.Path }}">
                    <span class="post-sigil" aria-hidden="true"></span>
                    <span class="post-copy">
                        <strong class="title">{{ $post.Title }}{{ if $post.Draft }} <small>(draft)</small>{{ end }}</strong>
                        {{ if $post.Description }}<small class="description">{{ $post.Description }}</small>{{ end }}
                        {{ with first $post.Tags }}<span class="tag">{{ . }}</span>{{ end }}
                    </span>
                    <time class="date" datetime="{{ datefmt "2006-01-02" $post.PubDate }}">{{ datefmt "2006-01-02" $post.PubDate }}</time>
                </a>
            {{ end }}
            </div>

            {{ with $data.Pagination }}
                {{ if gt .Pages 1 }}
                    <nav class="pagination-nav" aria-label="pagination">
                        {{ if .Prev }}<a href="{{ .Prev }}">← prev</a>{{ else }}<span class="is-disabled">← prev</span>{{ end }}
                        <span>{{ printf "%02d / %02d" .Page .Pages }}</span>
                        {{ if .Next }}<a href="{{ .Next }}">next →</a>{{ else }}<span class="is-disabled">next →</span>{{ end }}
                    </nav>
                {{ end }}
            {{ end }}
        {{ else }}
            <div class="tag-list">
                {{ range $row := $summary }}
                    {{ $n := index $row "PostCount" }}
                    {{ $w := "1" }}
                    {{ if ge $n 6 }}{{ $w = "4" }}{{ else if ge $n 3 }}{{ $w = "3" }}{{ else if ge $n 2 }}{{ $w = "2" }}{{ end }}
                    <a href="/posts/tag/{{ index $row "TagSlug" }}/" data-w="{{ $w }}">{{ index $row "Tag" }} <span class="n">{{ $n }}</span></a>
                {{ end }}
            </div>
        {{ end }}
    </div>
</main>

{{ template "site_footer" $data }}
</body>
</html>
{{ end }}
