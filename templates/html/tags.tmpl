{{ define "tags" }}
{{ query "select Tag, TagSlug, _page as Page from tags where Section = 'posts' and Draft = false order by TagSlug asc, PubDate desc" | paginateOnRoot "TagSlug" "tag-page" "tag-root" }}
{{ end }}

{{ define "tag-root" }}
{{ template "tags_document" (dict "Data" . "Mode" "root") }}
{{ end }}

{{ define "tag-page" }}
{{ template "tags_document" (dict "Data" . "Mode" "tag") }}
{{ end }}

{{ define "tags_document" }}
{{ $data := index . "Data" }}
{{ $mode := index . "Mode" }}
{{ $tagName := "" }}
{{ if and (eq $mode "tag") $data.Pagination }}
    {{ with first $data.Pagination.Items }}{{ $tagName = index . "Tag" }}{{ end }}
{{ end }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or $data.Page.Description $data.Site.Description }}
    {{ $pageTitle := printf "%s | %s" $data.Page.Title $data.Site.Title }}
    {{ if eq $mode "tag" }}
        {{ $pageTitle = printf "%v | Tags | %s" $tagName $data.Site.Title }}
        {{ $pageDescription = printf "Posts tagged %v" $tagName }}
    {{ end }}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="{{ $pageDescription }}">
    <meta name="author" content="Oliver McInnes">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ $data.Page.Canon }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ $data.Site.URL }}/assets/favicon/favicon-white-on-black-512.png">
    <meta property="og:url" content="{{ $data.Page.Canon }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ $data.Site.Title }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ $pageTitle }}">
    <meta name="twitter:description" content="{{ $pageDescription }}">
    <meta name="twitter:image" content="{{ $data.Site.URL }}/assets/favicon/favicon-white-on-black-512.png">

    <title>{{ $pageTitle }}</title>
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/posts.css" />
    <link rel="stylesheet" href="/assets/css/article.css" />
    <link rel="stylesheet" href="/assets/css/tags.css" />
    {{ template "icon_assets" $data }}
    {{ template "favicon_assets" $data }}
</head>
<body>
{{ $summary := query "select Tag, TagSlug, count(PageTitle) as PostCount from tags where Section = 'posts' and Draft = false group by TagSlug, Tag order by PostCount desc, Tag asc" }}
<main class="w-shell page-layout">
    {{ template "site_nav_archive" $data }}

    <section class="page-main">
        <header class="w-panel article-panel page-header archive-header">
            {{ if eq $mode "tag" }}
                <h1 class="w-title medium">Tag: {{ $tagName }}</h1>
            {{ else }}
                <h1 class="w-title medium">{{ $data.Page.Title }}</h1>
                {{ if $data.Page.Description }}<p class="archive-note">{{ $data.Page.Description }}</p>{{ end }}
            {{ end }}
        </header>

        {{ if eq $mode "tag" }}
            <div class="section-head archive-section-head">
                <div class="w-label">posts:</div>
                <nav class="archive-section-links" aria-label="Tag archive links">
                    <a class="section-link" href="/tags/">[all tags]</a>
                    <a class="section-link" href="/posts/">[all posts]</a>
                </nav>
            </div>

            <section class="post-list post-list-states">
                {{ range $row := $data.Pagination.Items }}
                    {{ $post := index $row "Page" }}
                    {{ if or $data.Site.Dev (not $post.Draft) }}
                        <article class="w-panel post-card{{ if $post.Featured }} is-featured{{ end }}{{ if $post.Draft }} is-draft{{ end }}">
                            <div class="post-card-content">
                                <div class="post-card-meta-row">
                                    <div class="post-card-meta">{{ datefmt "2006-01-02" $post.PubDate }}</div>
                                    {{ if $post.Featured }}
                                        <div class="post-card-flags">
                                            <span class="post-card-state featured">featured</span>
                                            {{ if $post.Draft }}<span class="post-card-state draft">draft</span>{{ end }}
                                        </div>
                                    {{ else if $post.Draft }}
                                        <div class="post-card-flags">
                                            <span class="post-card-state draft">draft</span>
                                        </div>
                                    {{ end }}
                                    {{ if $post.Tags }}
                                        <div class="post-card-tags">
                                            {{ range $tag := $post.Tags }}
                                                <a class="post-card-state post-card-tag post-card-tag-link" href="/tags/{{ $tag }}/">{{ $tag }}</a>
                                            {{ end }}
                                        </div>
                                    {{ end }}
                                </div>
                                <h2 class="post-card-title"><a class="post-card-primary-link" href="{{ $post.Canon }}">{{ $post.Title }}</a></h2>
                                {{ if $post.Description }}
                                    <p class="post-card-desc">{{ $post.Description }}</p>
                                {{ end }}
                            </div>
                        </article>
                    {{ end }}
                {{ end }}
            </section>

            {{ with $data.Pagination }}
                {{ if gt .Pages 1 }}
                    <nav class="pagination-nav" aria-label="pagination">
                        {{ if .Prev }}<a class="pagination-link" href="{{ .Prev }}">[Prev]</a>{{ else }}<span class="pagination-link is-disabled">[Prev]</span>{{ end }}
                        <span class="pagination-current">{{ printf "%02d" .Page }} / {{ printf "%02d" .Pages }}</span>
                        {{ if .Next }}<a class="pagination-link" href="{{ .Next }}">[Next]</a>{{ else }}<span class="pagination-link is-disabled">[Next]</span>{{ end }}
                    </nav>
                {{ end }}
            {{ end }}
        {{ else }}
            <section class="w-panel tag-index" aria-label="All tags">
                {{ range $row := $summary }}
                    <a class="tag-row" href="/tags/{{ index $row "TagSlug" }}/">
                        <span class="tag-row-name">#{{ index $row "Tag" }}</span>
                        <span class="tag-row-meta">{{ index $row "PostCount" }} {{ if eq (index $row "PostCount") 1 }}post{{ else }}posts{{ end }}</span>
                    </a>
                {{ end }}
            </section>
        {{ end }}
    </section>
    {{ template "site_footer" $data }}
</main>
</body>
</html>
{{ end }}
