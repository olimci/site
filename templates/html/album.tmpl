{{ define "album" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or .Page.Description .Site.Description }}
    {{ $pageTitle := printf "%s | %s" .Page.Title .Site.Title }}
    {{ $cover := index .Page.Params "cover" }}
    <meta name="description" content="{{ $pageDescription }}">
    <link rel="canonical" href="{{ .Page.Canon }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ .Site.URL }}{{ $cover }}">
    <meta property="og:url" content="{{ .Page.Canon }}">
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="{{ .Site.URL }}{{ $cover }}">

    <title>{{ $pageTitle }}</title>
    {{ template "head_common" . }}
</head>
<body>
{{ template "topnav" "photos" }}

{{ $photos := index .Page.Params "photos" }}

<main>
    <section class="page-header">
        <div class="page-header-inner">
            {{ if not .Page.PubDate.IsZero }}
            <div class="page-kicker">
                <span class="date">{{ datefmt "2006-01-02" .Page.PubDate }}</span>
            </div>
            {{ end }}
            <h1>{{ .Page.Title }}</h1>
            {{ if .Page.Description }}<p class="deck">{{ .Page.Description }}</p>{{ end }}
        </div>
    </section>

    <div class="album-shell">
        <div class="gallery">
            {{ range $photo := $photos }}
                <figure>
                    <span class="gallery-frame" style="background-image:url('{{ index $photo "src" }}')" aria-label="{{ index $photo "alt" }}"></span>
                    {{ with index $photo "caption" }}<figcaption>{{ . }}</figcaption>{{ end }}
                </figure>
            {{ end }}
        </div>
    </div>
</main>

{{ template "site_footer" . }}
</body>
</html>
{{ end }}
