{{ define "album" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or .Page.Description .Site.Description }}
    {{ $pageTitle := printf "%s | %s" .Page.Title .Site.Title }}
    {{ $cover := index .Page.Params "cover" }}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="{{ $pageDescription }}">
    <meta name="author" content="Oliver McInnes">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ .Page.Canon }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ .Site.URL }}{{ $cover }}">
    <meta property="og:url" content="{{ .Page.Canon }}">
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ $pageTitle }}">
    <meta name="twitter:description" content="{{ $pageDescription }}">
    <meta name="twitter:image" content="{{ .Site.URL }}{{ $cover }}">

    <title>{{ $pageTitle }}</title>
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/article.css" />
    <link rel="stylesheet" href="/assets/css/albums.css" />
    {{ template "icon_assets" . }}
    {{ template "favicon_assets" . }}
</head>
<body>
{{ $photos := index .Page.Params "photos" }}
<main class="w-shell page-layout">
    {{ template "site_nav_photo_item" . }}

    <section class="page-main">
        <article class="album-page">
            <header class="w-panel article-panel album-head">
                <div class="article-meta-row">
                    {{ if .Page.Featured }}<span class="post-card-state featured">featured</span>{{ end }}
                    {{ if .Page.Draft }}<span class="post-card-state draft">draft</span>{{ end }}
                    {{ range $tag := .Page.Tags }}<span class="post-card-state post-card-tag">{{ $tag }}</span>{{ end }}
                </div>
                <h1 class="w-title medium">{{ .Page.Title }}</h1>
                {{ if .Page.Description }}<p class="article-deck">{{ .Page.Description }}</p>{{ end }}
            </header>

            <section class="photo-grid">
                {{ range $photo := $photos }}
                    <figure class="photo-frame">
                        <img class="photo-image" src="{{ index $photo "src" }}" alt="{{ index $photo "alt" }}" loading="lazy" />
                        {{ with index $photo "caption" }}<figcaption>{{ . }}</figcaption>{{ end }}
                    </figure>
                {{ end }}
            </section>
        </article>
    </section>
    {{ template "site_footer" . }}
</main>
</body>
</html>
{{ end }}
