{{ define "post" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or .Page.Description .Site.Description }}
    {{ $pageTitle := printf "%s | %s" .Page.Title .Site.Title }}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="{{ $pageDescription }}">
    <meta name="author" content="Oliver McInnes">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ .Page.Canon }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">
    <meta property="og:url" content="{{ .Page.Canon }}">
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ $pageTitle }}">
    <meta name="twitter:description" content="{{ $pageDescription }}">
    <meta name="twitter:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">

    <title>{{ $pageTitle }}</title>
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/article.css" />
    {{ template "icon_assets" . }}
    {{ template "favicon_assets" . }}
</head>
<body>
<main class="w-shell page-layout">
    {{ if eq .Page.Section "posts" }}{{ template "site_nav_post_item" . }}{{ else }}{{ template "site_nav_archive" . }}{{ end }}

    <section class="page-main">
        <article class="w-panel article-panel">
            <header class="article-head">
                <div class="article-meta-row">
                    <span>{{ datefmt "2006-01-02" .Page.PubDate }}</span>
                    {{ if .Page.Featured }}<span class="post-card-state featured">featured</span>{{ end }}
                    {{ if .Page.Draft }}<span class="post-card-state draft">draft</span>{{ end }}
                    {{ range $tag := .Page.Tags }}<a class="post-card-state post-card-tag post-card-tag-link" href="/tags/{{ $tag }}/">{{ $tag }}</a>{{ end }}
                </div>
                <h1 class="w-title medium">{{ .Page.Title }}</h1>
                {{ if .Page.Description }}
                    <p class="article-deck">{{ .Page.Description }}</p>
                {{ end }}
            </header>

            <div class="w-article">{{ .Page.Body }}</div>
        </article>
    </section>
    {{ template "site_footer" . }}
</main>
</body>
</html>
{{ end }}
