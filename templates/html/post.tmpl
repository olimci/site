{{ define "post" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or .Page.Description .Site.Description }}
    {{ $pageTitle := printf "%s | %s" .Page.Title .Site.Title }}
    <meta name="description" content="{{ $pageDescription }}">
    <link rel="canonical" href="{{ .Page.Canon }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">
    <meta property="og:url" content="{{ .Page.Canon }}">
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ $pageTitle }}">
    <meta name="twitter:description" content="{{ $pageDescription }}">
    <meta name="twitter:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">

    <title>{{ $pageTitle }}</title>
    {{ template "head_common" . }}
</head>
<body>
{{ if eq .Page.Section "posts" }}{{ template "topnav" "posts" }}{{ else if eq .Page.Path "/cv/" }}{{ template "topnav" "cv" }}{{ else }}{{ template "topnav" "" }}{{ end }}

<main>

    <section class="page-header">
        <div class="page-header-inner">
            {{ if not .Page.PubDate.IsZero }}
            <div class="page-kicker">
                <span class="date">{{ datefmt "2006-01-02" .Page.PubDate }}</span>
            </div>
            {{ end }}
            <h1>{{ .Page.Title }}</h1>
            {{ if .Page.Description }}<p class="deck">{{ .Page.Description }}</p>{{ end }}
            {{ if .Page.Draft }}
            <div class="meta">
                <span>draft</span>
            </div>
            {{ end }}
        </div>
    </section>

    <div class="article-shell{{ if .Page.ToC }} has-toc{{ end }}">
        {{ if .Page.ToC }}
        <aside class="article-toc" aria-label="On this page">
            <span class="label">On this page</span>
            <ol>
                {{ range .Page.ToC }}
                    {{ if .ID }}<li class="toc-level-{{ .Level }}"><a href="#{{ .ID }}">{{ .Text }}</a></li>{{ end }}
                {{ end }}
            </ol>
        </aside>
        {{ end }}
        <article class="article">
            <div class="prose">{{ .Page.Body }}</div>
        </article>
    </div>
</main>

{{ template "site_footer" . }}
</body>
</html>
{{ end }}
