{{ define "posts" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or .Page.Description .Site.Description }}
    {{ $pageTitle := printf "%s | %s" .Page.Title .Site.Title }}
    <meta name="description" content="{{ $pageDescription }}">
    <link rel="canonical" href="{{ .Page.Canon }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">
    <meta property="og:url" content="{{ .Page.Canon }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ $pageTitle }}">
    <meta name="twitter:description" content="{{ $pageDescription }}">
    <meta name="twitter:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">

    <title>{{ $pageTitle }}</title>
    {{ template "head_common" . }}
    <link rel="stylesheet" href="/assets/css/posts.css">
</head>
<body>
{{ template "topnav" "posts" }}

{{ $posts := queryPages "SELECT * FROM pages WHERE Section='posts' AND (? OR Draft=false) ORDER BY PubDate DESC" .Site.Dev }}
{{ $tags := query "select Tag, TagSlug, count(PageTitle) as PostCount from tags where Section = 'posts' and (? OR Draft=false) group by TagSlug, Tag order by PostCount desc, Tag asc" .Site.Dev }}

<main class="posts-page">
    <section class="page-header">
        <div class="page-header-inner">
            <h1>{{ .Page.Title }}</h1>
        </div>
    </section>

    <div class="shell">
        {{ if $tags }}
        <div class="chips">
            <a class="chip is-active" href="/posts/">all <span class="n">{{ len $posts }}</span></a>
            {{ range $t := $tags }}
                <a class="chip" href="/posts/tag/{{ index $t "TagSlug" }}/">{{ index $t "Tag" }} <span class="n">{{ index $t "PostCount" }}</span></a>
            {{ end }}
            <a class="chip chip-more" href="/posts/tag/">*</a>
        </div>
        {{ end }}

        <div class="posts dither-surface">
        <canvas class="dither-field" aria-hidden="true"></canvas>
        <div class="posts-heading" aria-hidden="true">
            <span></span>
            <span>post</span>
            <span>date</span>
        </div>
        {{ range $post := $posts }}
            <a class="post dither-target" href="{{ $post.Path }}">
                <span class="post-sigil" aria-hidden="true"></span>
                <span class="post-copy">
                    <strong class="title">{{ $post.Title }}{{ if $post.Draft }} <small>(draft)</small>{{ end }}</strong>
                    {{ if $post.Description }}<small class="description">{{ $post.Description }}</small>{{ end }}
                    {{ with first $post.Tags }}<span class="tag">{{ . }}</span>{{ end }}
                </span>
                <time class="date" datetime="{{ datefmt "2006-01-02" $post.PubDate }}">{{ datefmt "2006-01-02" $post.PubDate }}</time>
            </a>
        {{ end }}
        </div>
    </div>
</main>

{{ template "site_footer" . }}
</body>
</html>
{{ end }}
