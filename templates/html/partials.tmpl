{{ define "favicon_assets" }}
{{ $light := "/assets/symbols/olimci-black.svg" }}
{{ $dark := "/assets/symbols/olimci-white.svg" }}
{{ if or (eq .Page.Section "shizuka") (eq .Page.Section "shizuka-docs") }}
    {{ $light = "/assets/symbols/shizuka-black.svg" }}
    {{ $dark = "/assets/symbols/shizuka-white.svg" }}
{{ else if or (eq .Page.Section "tohru") (eq .Page.Section "tohru-docs") }}
    {{ $light = "/assets/symbols/tohru-black.svg" }}
    {{ $dark = "/assets/symbols/tohru-white.svg" }}
{{ end }}
<link rel="icon" type="image/svg+xml" href="{{ $light }}" media="(prefers-color-scheme: light)">
<link rel="icon" type="image/svg+xml" href="{{ $dark }}" media="(prefers-color-scheme: dark)">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-black-transparent-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon-black-transparent-180.png">
{{ end }}

{{ define "fonts" }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
{{ end }}

{{ define "topnav" }}
{{ $active := . }}
<header class="topnav">
    <div class="glass-backdrop" aria-hidden="true"></div>
    <div class="topnav-inner">
        <a class="brand" href="/">
            <span class="symbol symbol-olimci" aria-hidden="true"></span>
            <span>olimci.com</span>
        </a>
        <nav class="topnav-links" aria-label="Primary">
            <a href="/" {{ if eq $active "home" }}class="active"{{ end }}>home</a>
            <a href="/posts/" {{ if eq $active "posts" }}class="active"{{ end }}>posts</a>
            <a href="/photos/" {{ if eq $active "photos" }}class="active"{{ end }}>photos</a>
            <a href="/cv/" {{ if eq $active "cv" }}class="active"{{ end }}>cv</a>
        </nav>
    </div>
</header>
{{ end }}

{{ define "site_footer" }}
<footer class="site-footer">
    <div class="site-footer-inner">
        <span>&copy; 2026 oliver mcinnes</span>
        <span>built with <a href="/shizuka">shizuka</a> &middot; <a href="http://olimci.com/_shizuka">c#{{ .Site.Git.ShortHash }}</a></span>
    </div>
</footer>
{{ end }}

{{ define "head_common" }}
{{ $data := . }}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="author" content="Oliver McInnes">
<meta name="robots" content="index, follow">
<link rel="alternate" type="application/rss+xml" title="olimci.com RSS" href="{{ $data.Site.URL }}/rss.xml">
{{ template "fonts" . }}
<link rel="stylesheet" href="/assets/css/site.css">
{{ template "favicon_assets" . }}
{{ end }}

{{ define "copy_code_script" }}
<script>
document.addEventListener("DOMContentLoaded", () => {
    for (const pre of document.querySelectorAll(".shizuka-prose pre")) {
        const code = pre.querySelector("code");
        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy-code";
        button.setAttribute("aria-label", "Copy code");
        button.textContent = "Copy";
        button.addEventListener("click", async () => {
            await navigator.clipboard.writeText(code.innerText);
            button.textContent = "Copied";
            window.setTimeout(() => {
                button.textContent = "Copy";
            }, 1200);
        });
        pre.classList.add("has-copy-code");
        pre.append(button);
    }
});
</script>
{{ end }}
