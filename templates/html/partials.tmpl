{{ define "nav_home_icon" }}
<span class="seven-seg-icon" data-seven-seg-morph data-from="h00,h10,h02,h12,v00,v01,v10,v20,v21,d01b,d11a" data-to="h00,h10,h02,h12,v00,v01,v11,v20,v21,d00a,d10b" data-duration-ms="0" data-fade-ms="72" data-size="100%" data-outline-width="0" aria-hidden="true"></span>
{{ end }}

{{ define "nav_back_icon" }}
<span class="seven-seg-icon" data-seven-seg-morph data-from="h01,h11,d00b,d01a" data-to="d00b,d10b,d01a,d11a" data-duration-ms="0" data-fade-ms="72" data-size="100%" data-outline-width="0" aria-hidden="true"></span>
{{ end }}

{{ define "nav_random_icon" }}
<span class="seven-seg-icon" data-seven-seg-morph data-from="h00,h10,h02,h12,v00,v01,v20,v21,d10a,d10b,d01a,d01b" data-to="h00,h10,h02,h12,v00,v01,v20,v21,d00a,d00b,d11a,d11b" data-duration-ms="260" data-fade-ms="72" data-size="100%" data-outline-width="0" aria-hidden="true"></span>
{{ end }}

{{ define "nav_random_post" }}
{{ $posts := queryPages "SELECT * FROM pages WHERE Section='posts' AND (? OR Draft=false) ORDER BY PubDate DESC" .Site.Dev }}
{{ $fallback := "/posts/" }}
{{ with first $posts }}{{ $fallback = printf "/%s/" .Canon }}{{ end }}
<a class="toolbar-link toolbar-random" href="{{ $fallback }}" aria-label="Random Post" data-label="Random Post" data-random-nav>{{ template "nav_random_icon" . }}</a>
<div class="nav-random-options" hidden>
    {{ range $post := $posts }}
        <a href="/{{ $post.Canon }}/"></a>
    {{ end }}
</div>
{{ end }}

{{ define "nav_random_post_desktop" }}
{{ $posts := queryPages "SELECT * FROM pages WHERE Section='posts' AND (? OR Draft=false) ORDER BY PubDate DESC" .Site.Dev }}
{{ $fallback := "/posts/" }}
{{ with first $posts }}{{ $fallback = printf "/%s/" .Canon }}{{ end }}
<a class="toolbar-link toolbar-random toolbar-random-desktop" href="{{ $fallback }}" aria-label="Random Post" data-label="Random Post" data-random-nav>{{ template "nav_random_icon" . }}</a>
<div class="nav-random-options" hidden>
    {{ range $post := $posts }}
        <a href="/{{ $post.Canon }}/"></a>
    {{ end }}
</div>
{{ end }}

{{ define "nav_random_album_mobile" }}
{{ $albums := queryPages "SELECT * FROM pages WHERE Section='photos' AND (? OR Draft=false) ORDER BY Weight ASC, Updated DESC" .Site.Dev }}
{{ $fallback := "/photos/" }}
{{ with first $albums }}{{ $fallback = printf "/%s/" .Canon }}{{ end }}
<a class="toolbar-link toolbar-random toolbar-random-mobile" href="{{ $fallback }}" aria-label="Random Album" data-label="Random Album" data-random-nav>{{ template "nav_random_icon" . }}</a>
<div class="nav-random-options" hidden>
    {{ range $album := $albums }}
        <a href="/{{ $album.Canon }}/"></a>
    {{ end }}
</div>
{{ end }}

{{ define "nav_random_script" }}
<script>
(() => {
    if (window.SiteRandomPostNav) {
        window.SiteRandomPostNav.init(document);
        return;
    }

    function init(root = document) {
        const links = root.querySelectorAll("[data-random-nav]");
        for (const link of links) {
            if (link.__siteRandomPostNav) {
                continue;
            }

            const options = link.parentElement?.querySelectorAll(".nav-random-options a[href]") || [];
            const targets = Array.from(options, (option) => option.href).filter(Boolean);
            if (targets.length === 0) {
                continue;
            }

            link.__siteRandomPostNav = true;
            link.addEventListener("click", () => {
                link.href = targets[Math.floor(Math.random() * targets.length)];
            });
        }
    }

    window.SiteRandomPostNav = { init };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => init(document), { once: true });
    } else {
        init(document);
    }
})();
</script>
{{ end }}

{{ define "linktree_nav_links" }}
{{ $linktreePage := queryPage "SELECT * FROM pages WHERE Path='/links/' LIMIT 1" }}
{{ $linktreeLinks := or (index $linktreePage.Params "exported_links") (index $linktreePage.Params "links") }}
<nav class="nav-box nav-links-box w-linklist sidebar-links" aria-label="linktree">
    {{ range $link := $linktreeLinks }}
        {{ $iconMorph := or (index $link "icon_morph") (index $link "iconMorph") }}
        <a class="toolbar-link sidebar-link" href="{{ index $link "url" }}" aria-label="{{ index $link "label" }}" data-label="{{ index $link "label" }}">
            {{ if $iconMorph }}{{ template "icon" $iconMorph }}{{ end }}
            <span class="sidebar-link-label">{{ index $link "label" }}</span>
        </a>
    {{ end }}
</nav>
{{ end }}

{{ define "site_nav_title" }}
{{ $navTitle := or (index .Site.Params "nav_title") .Site.Title }}
<div class="nav-title" aria-hidden="true">{{ $navTitle }}</div>
{{ end }}

{{ define "site_footer" }}
<footer class="site-footer">
    <span>&copy; 2026 Oliver McInnes <a href="http://localhost:6767/_shizuka">c#{{.Site.Git.ShortHash}}</a></span>
</footer>
{{ end }}

{{ define "site_nav_home" }}
<aside class="nav-toolbar nav-toolbar-index" aria-label="linktree">
    <div class="nav-box nav-action-box">
        {{ template "nav_random_post" . }}
    </div>
    {{ template "linktree_nav_links" . }}
</aside>
{{ template "nav_random_script" . }}
{{ end }}

