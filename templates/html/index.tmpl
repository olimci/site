{{ define "index" }}
<!DOCTYPE html>
<html class="home-page" lang="en">
<head>
    <meta name="description" content="{{ .Site.Description }}">
    <meta name="keywords" content="Oliver McInnes, Oli McInnes, programming, physics, personal blog, cv">
    <link rel="canonical" href="{{ .Site.URL }}/">

    <meta property="og:title" content="{{ .Site.Title }}">
    <meta property="og:description" content="{{ .Site.Description }}">
    <meta property="og:image" content="{{ .Site.URL }}/assets/favicon/bird-512.png">
    <meta property="og:url" content="{{ .Site.URL }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ .Site.Title }}">
    <meta name="twitter:description" content="{{ .Site.Description }}">
    <meta name="twitter:image" content="{{ .Site.URL }}/assets/favicon/bird-512.png">

    <title>{{ .Site.Title }}</title>
    {{ template "head_common" . }}
</head>
<body>
{{ template "topnav" (dict "Data" . "Active" "home") }}
<main class="home-main">
    <div class="forum-welcome">{{ .Page.Body }}</div>
    <section class="home-primary">
        <div class="forum-subhead"><span>Post</span><span>Published</span></div>
        {{ $posts := queryPages "SELECT * FROM pages WHERE Section='posts' AND Featured=true AND (? OR Draft=false) ORDER BY PubDate DESC" .Site.Dev }}
        {{ range $post := $posts }}
        <a class="home-post-row" href="{{ $post.Path }}">
            <img src="/assets/silk/page_white_text.png" width="16" height="16" alt="">
            <span><strong>{{ $post.Title }}</strong>{{ with $post.Description }}<small>{{ . }}</small>{{ end }}</span>
            <time datetime="{{ datefmt "2006-01-02" $post.PubDate }}">{{ datefmt "02 Jan 2006" $post.PubDate }}</time>
        </a>
        {{ end }}
        <div class="home-more"><a href="/posts/">View all posts &raquo;</a></div>
    </section>
    <section class="home-elsewhere" aria-label="Other">
        <div class="forum-subhead">Other</div>
        <a href="/about/"><img src="/assets/silk/user.png" width="16" height="16" alt=""><span><strong>About me</strong><small>Who is writing this?</small></span></a>
        <a href="/about-site/"><img src="/assets/silk/information.png" width="16" height="16" alt=""><span><strong>About this site</strong><small>Design and credits</small></span></a>
        <a href="/cv/"><img src="/assets/silk/briefcase.png" width="16" height="16" alt=""><span><strong>CV</strong><small>Experience and projects</small></span></a>
        <a href="/photos/"><img src="/assets/silk/photos.png" width="16" height="16" alt=""><span><strong>Photographs</strong><small>Albums and travels</small></span></a>
        <a href="/links/"><img src="/assets/silk/link.png" width="16" height="16" alt=""><span><strong>Links</strong><small>Other places on the web</small></span></a>
    </section>
</main>
{{ template "site_footer" . }}
</body>
</html>
{{ end }}
