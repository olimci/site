{{ define "index" }}
<!DOCTYPE html>
<html class="home-page" lang="en">
<head>
    <meta name="description" content="{{ .Site.Description }}">
    <meta name="keywords" content="Oliver McInnes, Oli McInnes, programming, physics, personal blog, cv">
    <link rel="canonical" href="{{ .Site.URL }}/">

    <meta property="og:title" content="{{ .Site.Title }}">
    <meta property="og:description" content="{{ .Site.Description }}">
    <meta property="og:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">
    <meta property="og:url" content="{{ .Site.URL }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ .Site.Title }}">
    <meta name="twitter:description" content="{{ .Site.Description }}">
    <meta name="twitter:image" content="{{ .Site.URL }}/assets/favicon/favicon-white-on-black-512.png">

    <title>{{ .Site.Title }}</title>
    {{ template "head_common" . }}
    <script src="/assets/js/hero.js" defer></script>
</head>
<body>
{{ template "topnav" "home" }}

{{ $sections := index .Page.Params "sections" }}
{{ $projects := index .Page.Params "projects" }}
{{ $posts := queryPages "SELECT * FROM pages WHERE Section='posts' AND Featured=true AND (? OR Draft=false) ORDER BY Weight ASC, PubDate DESC LIMIT 8" .Site.Dev }}
{{ $albums := queryPages "SELECT * FROM pages WHERE Featured=true AND Draft=false AND Section='photos' ORDER BY Weight ASC, Updated DESC LIMIT 3" }}

<main>

    <section class="hero">
        <div class="hero-frame">
            <div class="hero-fallback" aria-hidden="true"></div>
            <div class="hero-inner">
                <div class="hero-text">
                    <div class="hero-mark-shell">
                        <h1 class="hero-mark" aria-label="olimci">
                            <span class="symbol symbol-o" aria-hidden="true"></span>
                            <span class="symbol symbol-l" aria-hidden="true"></span>
                            <span class="symbol symbol-i" aria-hidden="true"></span>
                        </h1>
                    </div>
                </div>
            </div>
            <canvas class="hero-field" aria-hidden="true"></canvas>
        </div>
    </section>

    <div class="shell" id="content">

        {{ range $section := $sections }}
            {{ $kind := index $section "kind" }}
            {{ if eq $kind "content" }}
                <section class="section">
                    {{ if index $section "title" }}
                        <div class="section-head"><h2>{{ index $section "title" }}</h2></div>
                    {{ end }}
                    <div class="about">{{ index $.Page.Sections (index $section "section") }}</div>
                </section>
            {{ else if eq $kind "projects_shelf" }}
                {{ if $projects }}
                <section class="section" id="{{ index $section "id" }}">
                    <div class="section-head"><h2>{{ index $section "title" }}</h2></div>
                    <div class="cards cards-shelf project-shelf">
                        {{ range $project := $projects }}
                            {{ $colour := or (index $project "colour") "paper" }}
                            {{ $meta := index $project "meta" }}
                            {{ $url := index $project "url" }}
                            <a class="card" data-colour="{{ $colour }}" href="{{ $url }}">
                                <div class="card-cover project-cover"><span class="symbol symbol-{{ $colour }}" aria-hidden="true"></span></div>
                                <div class="card-body">
                                    <h3>{{ index $project "title" }}</h3>
                                    {{ if $meta }}<span class="meta">{{ $meta }}</span>{{ end }}
                                    {{ with index $project "description" }}<p>{{ . }}</p>{{ end }}
                                </div>
                            </a>
                        {{ end }}
                    </div>
                </section>
                {{ end }}
            {{ else if eq $kind "posts_shelf" }}
                <section class="section">
                    <div class="section-head">
                        <h2>{{ index $section "title" }}</h2>
                        <a class="more" href="/posts/">all posts &rarr;</a>
                    </div>
                    <div class="posts">
                        {{ range $post := $posts }}
                            <a class="post" href="{{ $post.Path }}">
                                <span class="date">{{ datefmt "2006-01-02" $post.PubDate }}</span>
                                <span class="title">{{ $post.Title }}</span>
                                {{ with first $post.Tags }}<span class="tag">{{ . }}</span>{{ end }}
                            </a>
                        {{ end }}
                    </div>
                </section>
            {{ else if eq $kind "photos_shelf" }}
                {{ if $albums }}
                <section class="section">
                    <div class="section-head">
                        <h2>{{ index $section "title" }}</h2>
                        <a class="more" href="/photos/">all albums &rarr;</a>
                    </div>
                    <div class="cards cards-shelf photo-shelf">
                        {{ range $album := $albums }}
                            {{ $cover := index $album.Params "cover" }}
                            <a class="card" href="{{ $album.Path }}">
                                <div class="card-cover" {{ if $cover }}style="background:#000 center/cover no-repeat url('{{ $cover }}')"{{ end }}></div>
                                <div class="card-body">
                                    <h3>{{ $album.Title }}</h3>
                                    <span class="meta">{{ datefmt "2006-01-02" $album.PubDate }}</span>
                                    {{ with $album.Description }}<p>{{ . }}</p>{{ end }}
                                </div>
                            </a>
                        {{ end }}
                    </div>
                </section>
                {{ end }}
            {{ end }}
        {{ end }}

    </div>
</main>

{{ template "site_footer" . }}
</body>
</html>
{{ end }}
