{{ define "album" }}
<!DOCTYPE html>
<html lang="en">
<head>
    {{ $pageDescription := or .Page.Description .Site.Description }}
    {{ $pageURL := or .Page.Canon (printf "%s/%s/" .Site.URL .Page.Slug) }}
    {{ $pageTitle := printf "%s | %s" .Page.Title .Site.Title }}
    {{ $cover := index .Page.Params "cover" }}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="{{ $pageDescription }}">
    <meta name="author" content="Oliver McInnes">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ $pageURL }}">

    <meta property="og:title" content="{{ $pageTitle }}">
    <meta property="og:description" content="{{ $pageDescription }}">
    <meta property="og:image" content="{{ .Site.URL }}{{ $cover }}">
    <meta property="og:url" content="{{ $pageURL }}">
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="{{ .Site.Title }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ $pageTitle }}">
    <meta name="twitter:description" content="{{ $pageDescription }}">
    <meta name="twitter:image" content="{{ .Site.URL }}{{ $cover }}">

    <title>{{ $pageTitle }}</title>
    <link rel="stylesheet" href="/styles.css" />
    {{ template "seven_seg_icon_assets" . }}
    <link rel="icon" href="/favicon.png" type="image/png" />
</head>
<body>
{{ $sideLinks := index .Site.Params "side_links" }}
{{ $photos := index .Page.Params "photos" }}
<main class="w-shell page-layout">
    <aside class="w-column page-rail">
        <a class="identity-home" href="/" aria-label="home">
            <h1 class="identity-title">
                <span class="identity-line">oli.</span>
                <span class="identity-line">mcinnes</span>
                <span class="identity-line identity-line-right">.cc</span>
            </h1>
        </a>

        <nav class="w-linklist sidebar-links" aria-label="site">
            {{ range $link := $sideLinks }}
                {{ $iconMorph := or (index $link "icon_morph") (index $link "iconMorph") }}
                <a class="sidebar-link" href="{{ index $link "url" }}">
                    {{ if $iconMorph }}{{ template "seven_seg_icon" $iconMorph }}{{ end }}
                    <span class="sidebar-link-label">{{ index $link "label" }}</span>
                </a>
            {{ end }}
        </nav>
    </aside>

    <section class="page-main">
        <article class="album-page">
            <header class="w-panel article-panel album-head">
                <div class="article-meta-row">
                    <a class="section-link" href="/photos/">[All photos]</a>
                    {{ if .Page.Featured }}<span class="post-card-state featured">featured</span>{{ end }}
                    {{ if .Page.Draft }}<span class="post-card-state draft">draft</span>{{ end }}
                    {{ range $tag := .Page.Tags }}<span class="post-card-state post-card-tag">{{ $tag }}</span>{{ end }}
                </div>
                <h1 class="w-title medium">{{ .Page.Title }}</h1>
                {{ if .Page.Description }}<p class="article-deck">{{ .Page.Description }}</p>{{ end }}
            </header>

            <section class="photo-grid">
                {{ range $photo := $photos }}
                    <figure class="photo-frame">
                        <img class="photo-image" src="{{ index $photo "src" }}" alt="{{ index $photo "alt" }}" loading="lazy" />
                        {{ with index $photo "caption" }}<figcaption>{{ . }}</figcaption>{{ end }}
                    </figure>
                {{ end }}
            </section>
        </article>
    </section>
</main>
</body>
</html>
{{ end }}
